    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.3" />
    <PackageVersion Include="MSTest" Version="3.8.3" />
    <PackageVersion Include="System.Management" Version="10.0.0" />
  </ItemGroup>
</Project>
