#include <windows.h>
1 ICON "@APP_ICON@"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 1L
FILESUBTYPE 0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DisplayPilot"
      VALUE "FileDescription", "Native Windows monitor controls"
      VALUE "OriginalFilename", "DisplayPilot.exe"
      VALUE "ProductName", "DisplayPilot"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
