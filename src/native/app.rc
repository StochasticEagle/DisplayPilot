#include <windows.h>

#include "resource.h"

// Fixed surfaces are editable in Visual Studio's native Dialog Editor.
// Runtime layout preserves DPI scaling, scrolling and variable monitor counts.
IDD_DISPLAYPILOT_ADVANCED DIALOGEX 0, 0, 570, 460
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_VSCROLL | WS_CLIPCHILDREN | DS_SETFONT
CAPTION "DisplayPilot - Advanced"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "",IDC_ADV_ICON,"Static",WS_CHILD | WS_VISIBLE | SS_OWNERDRAW,16,14,22,22
    LTEXT           "DisplayPilot",IDC_ADV_BRAND,45,14,220,17
    LTEXT           "Version",IDC_ADV_VERSION,45,32,220,13
    LTEXT           "Displays",IDC_ADV_DISPLAYS_HEADING,16,60,340,20
    LTEXT           "Appearance and scheduling",IDC_ADV_SCHEDULE_HEADING,16,90,340,20
    PUSHBUTTON      "Light mode",IDC_ADV_THEME_LIGHT,16,116,90,21
    PUSHBUTTON      "Dark mode",IDC_ADV_THEME_DARK,115,116,90,21
    AUTOCHECKBOX    "Enable automatic schedule",IDC_ADV_SCHEDULE,16,148,300,17
    AUTOCHECKBOX    "Reduce brightness during dark hours",IDC_ADV_REDUCE,16,170,300,17
    COMBOBOX        IDC_ADV_MODE,16,198,125,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Light at",IDC_ADV_LIGHT_CAPTION,147,202,43,14
    EDITTEXT        IDC_ADV_LIGHT_TIME,192,198,49,19,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Dark at",IDC_ADV_DARK_CAPTION,249,202,43,14
    EDITTEXT        IDC_ADV_DARK_TIME,294,198,49,19,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Latitude",IDC_ADV_LATITUDE_CAPTION,16,227,51,14
    EDITTEXT        IDC_ADV_LATITUDE,70,224,65,19,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Longitude",IDC_ADV_LONGITUDE_CAPTION,145,227,53,14
    EDITTEXT        IDC_ADV_LONGITUDE,200,224,65,19,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Location",IDC_ADV_LOCATION_CAPTION,16,253,50,14
    EDITTEXT        IDC_ADV_LOCATION_LABEL,70,251,280,19,ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Automatically update location when changed",IDC_ADV_AUTO_LOCATION,16,279,290,18
    PUSHBUTTON      "Update location now",IDC_ADV_UPDATE_LOCATION,16,303,115,22
    PUSHBUTTON      "Save schedule",IDC_ADV_SAVE,16,335,115,22
    LTEXT           "Windows integration",IDC_ADV_INTEGRATION_HEADING,16,371,340,18
    AUTOCHECKBOX    "Start when signing into Windows",IDC_ADV_STARTUP,16,394,226,19
    PUSHBUTTON      "Copy diagnostics",IDC_ADV_DIAGNOSTICS,250,394,106,22
    LTEXT           "",IDC_ADV_STATUS,16,423,430,30
END

IDD_DISPLAYPILOT_FLYOUT DIALOGEX 0, 0, 204, 148
STYLE WS_POPUP | WS_BORDER | WS_VSCROLL | WS_CLIPCHILDREN | DS_SETFONT
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "DisplayPilot"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "DisplayPilot",IDC_FLY_TITLE,12,10,176,19
    LTEXT           "No controllable monitors detected",IDC_FLY_EMPTY,12,35,176,19
    AUTORADIOBUTTON "Light",IDC_FLY_LIGHT,12,66,82,20,WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Dark",IDC_FLY_DARK,100,66,82,20,WS_TABSTOP
    AUTOCHECKBOX    "Automatic schedule",IDC_FLY_SCHEDULE,12,93,176,21
    PUSHBUTTON      "Advanced settings...",IDC_FLY_ADVANCED,12,119,176,23
END


IDD_ADVANCED_MONITOR DIALOGEX 0, 0, 340, 156
STYLE WS_CHILD | DS_CONTROL | DS_SETFONT | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Monitor name",IDC_ADV_ROW_NAME,2,2,310,18
    LTEXT       "Brightness",IDC_ADV_ROW_BRIGHTNESS_LABEL,2,27,90,16
    CONTROL     "",IDC_ADV_ROW_BRIGHTNESS,"msctls_trackbar32",WS_TABSTOP | 0x10,94,25,205,20
    LTEXT       "Contrast",IDC_ADV_ROW_CONTRAST_LABEL,2,53,90,16
    CONTROL     "",IDC_ADV_ROW_CONTRAST,"msctls_trackbar32",WS_TABSTOP | 0x10,94,51,205,20
    LTEXT       "Color preset",IDC_ADV_ROW_COLOR_LABEL,2,80,90,16
    COMBOBOX    IDC_ADV_ROW_COLOR,94,76,162,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Apply",IDC_ADV_ROW_COLOR_APPLY,261,76,58,20
    LTEXT       "Orientation",IDC_ADV_ROW_ROTATION_LABEL,2,106,90,16
    COMBOBOX    IDC_ADV_ROW_ROTATION,94,103,162,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Apply",IDC_ADV_ROW_ROTATION_APPLY,261,103,58,20
END

IDD_FLYOUT_MONITOR DIALOGEX 0, 0, 204, 116
STYLE WS_CHILD | DS_CONTROL | DS_SETFONT | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Monitor name",IDC_FLY_ROW_NAME,3,2,193,17
    LTEXT       "Brightness",IDC_FLY_ROW_BRIGHTNESS_LABEL,3,26,73,17
    CONTROL     "",IDC_FLY_ROW_BRIGHTNESS,"msctls_trackbar32",WS_TABSTOP | 0x10,78,25,119,19
    LTEXT       "Contrast",IDC_FLY_ROW_CONTRAST_LABEL,3,50,73,17
    CONTROL     "",IDC_FLY_ROW_CONTRAST,"msctls_trackbar32",WS_TABSTOP | 0x10,78,49,119,19
    LTEXT       "Color temperature",IDC_FLY_ROW_COLOR_LABEL,3,74,74,20
    COMBOBOX    IDC_FLY_ROW_COLOR,78,73,119,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

1 ICON "displaypilot-primary.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 1L
FILESUBTYPE 0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DisplayPilot"
      VALUE "FileDescription", "Native Windows monitor controls"
      VALUE "OriginalFilename", "DisplayPilot.exe"
      VALUE "ProductName", "DisplayPilot"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
