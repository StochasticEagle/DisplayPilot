<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DisplayPilot.App</RootNamespace>
    <AssemblyName>DisplayPilot</AssemblyName>
    <Description>WinUI 3 desktop application for DisplayPilot.</Description>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\displaypilot-primary.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseAppHost Condition="'$(Configuration)' == 'Release'">false</UseAppHost>
    <GenerateDependencyFile Condition="'$(Configuration)' == 'Release'">false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles Condition="'$(Configuration)' == 'Release'">false</GenerateRuntimeConfigurationFiles>
    <PublishSingleFile>false</PublishSingleFile>
    <DisableEmbeddedXbf>false</DisableEmbeddedXbf>
    <SatelliteResourceLanguages Condition="'$(Configuration)' == 'Release'">en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\displaypilot-compact.ico" />
    <EmbeddedResource Include="Assets\displaypilot-primary-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <ProjectReference Include="..\DisplayPilot.Core\DisplayPilot.Core.csproj" />
    <ProjectReference Include="..\DisplayPilot.Display\DisplayPilot.Display.csproj" />
    <ProjectReference Include="..\DisplayPilot.Windows\DisplayPilot.Windows.csproj" />
  </ItemGroup>

  <Target Name="CreateNativeReleaseHost" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command='powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-native-host.ps1&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -OutputDirectory &quot;$(TargetDir)&quot; -IntermediateDirectory &quot;$(IntermediateOutputPath)&quot;' />
    <Exec Command='powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\verify-release-resources.ps1&quot; -Directory &quot;$(TargetDir)&quot;' />
  </Target>

  <Target Name="FinalizeNativeReleasePublish" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetDir)DisplayPilot.exe"
          DestinationFiles="$(PublishDir)DisplayPilot.exe" />
    <Exec Command='powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\verify-release-resources.ps1&quot; -Directory &quot;$(PublishDir)&quot;' />
  </Target>

  <Target Name="RemoveUnusedWebViewRuntime" AfterTargets="Publish">
    <ItemGroup>
      <UnusedWebViewRuntime Include="$(PublishDir)Microsoft.Web.WebView2.Core.dll" />
      <UnusedWebViewRuntime Include="$(PublishDir)Microsoft.Web.WebView2.Core.Projection.dll" />
      <UnusedWebViewRuntime Include="$(PublishDir)WebView2Loader.dll" />
    </ItemGroup>
    <Delete Files="@(UnusedWebViewRuntime)" />
  </Target>
</Project>
