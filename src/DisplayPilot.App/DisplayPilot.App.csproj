<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DisplayPilot.App</RootNamespace>
    <AssemblyName>DisplayPilot</AssemblyName>
    <Description>WinUI 3 desktop application for DisplayPilot.</Description>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <OptimizationPreference>Size</OptimizationPreference>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <DisableEmbeddedXbf>false</DisableEmbeddedXbf>
    <_SupportEmbedFileResources>true</_SupportEmbedFileResources>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\displaypilot-primary.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\displaypilot-compact.ico" />
    <EmbeddedResource Include="Assets\displaypilot-primary-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <ProjectReference Include="..\DisplayPilot.Core\DisplayPilot.Core.csproj" />
    <ProjectReference Include="..\DisplayPilot.Display\DisplayPilot.Display.csproj" />
    <ProjectReference Include="..\DisplayPilot.Windows\DisplayPilot.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <StripSymbols>true</StripSymbols>
    <!-- AOT compilation resolves references from NuGet; do not mirror the
         entire managed runtime into the Release build directory. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <!-- XAML is compiled into the WinUI resource index; remove only loose
       copies after packaging. These tasks use MSBuild, not a shell. -->
  <Target Name="RemoveLooseCompiledXamlFromBuild" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <LooseCompiledXaml Include="$(TargetDir)**\App.xbf;$(TargetDir)**\MainWindow.xbf" />
    </ItemGroup>
    <Delete Files="@(LooseCompiledXaml)" />
  </Target>
  <Target Name="RemoveLooseCompiledXamlFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedCompiledXaml Include="$(PublishDir)**\App.xbf;$(PublishDir)**\MainWindow.xbf" />
    </ItemGroup>
    <Delete Files="@(PublishedCompiledXaml)" />
  </Target>

  <!-- Remove diagnostic tools, symbols, and localization from Release outputs.
       Debug retains its symbols and ordinary diagnostic artifacts. -->
  <Target Name="CleanReleaseBuildOutput" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ReleaseBuildArtifacts Include="$(TargetDir)crashdump.exe;$(TargetDir)createdump.exe;$(TargetDir)**\*.pdb;$(TargetDir)**\*.ilk" />
    </ItemGroup>
    <Delete Files="@(ReleaseBuildArtifacts)" />
  </Target>
  <Target Name="CleanReleasePublishOutput" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReleaseArtifacts Include="$(PublishDir)**\*.pdb;$(PublishDir)**\*.ilk;$(PublishDir)**\*.dbg;$(PublishDir)**\*.map;$(PublishDir)**\*.xml;$(PublishDir)**\*.resources.dll;$(PublishDir)**\*.mui;$(PublishDir)**\crashdump.exe;$(PublishDir)**\createdump.exe" />
    </ItemGroup>
    <Delete Files="@(ReleaseArtifacts)" />
    <RemoveDir Directories="$(PublishDir)ar;$(PublishDir)bg;$(PublishDir)ca;$(PublishDir)cs;$(PublishDir)da;$(PublishDir)de;$(PublishDir)el;$(PublishDir)en;$(PublishDir)es;$(PublishDir)et;$(PublishDir)fi;$(PublishDir)fr;$(PublishDir)he;$(PublishDir)hi;$(PublishDir)hr;$(PublishDir)hu;$(PublishDir)id;$(PublishDir)it;$(PublishDir)ja;$(PublishDir)ko;$(PublishDir)lt;$(PublishDir)lv;$(PublishDir)ms;$(PublishDir)nl;$(PublishDir)no;$(PublishDir)pl;$(PublishDir)pt;$(PublishDir)pt-BR;$(PublishDir)pt-PT;$(PublishDir)ro;$(PublishDir)ru;$(PublishDir)sk;$(PublishDir)sl;$(PublishDir)sr;$(PublishDir)sv;$(PublishDir)th;$(PublishDir)tr;$(PublishDir)uk;$(PublishDir)vi;$(PublishDir)zh-Hans;$(PublishDir)zh-Hant;$(PublishDir)zh-CN;$(PublishDir)zh-TW" />
    <Error Condition="Exists('$(PublishDir)DisplayPilot.runtimeconfig.json') or Exists('$(PublishDir)DisplayPilot.deps.json')"
           Text="Runtime metadata JSON files are prohibited." />
  </Target>

  <!-- Fail rather than silently falling back to a framework-dependent
       apphost or bundling the SDK runtimes. Enforced in Debug and Release. -->
  <Target Name="EnforceCompiledApplication" BeforeTargets="Build;Publish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(PublishAot)' != 'true'"
           Text="DisplayPilot requires a C# Native AOT application executable." />
    <Error Condition="'$(PublishSingleFile)' == 'true'"
           Text="DisplayPilot does not permit single-file .NET bundling." />
    <Error Condition="'$(WindowsAppSDKSelfContained)' == 'true'"
           Text="DisplayPilot must use the installed Windows App SDK runtime." />
    <Error Condition="'$(GenerateDependencyFile)' != 'false' or '$(GenerateRuntimeConfigurationFiles)' != 'false'"
           Text="DisplayPilot must never generate .deps.json or .runtimeconfig.json." />
  </Target>
  <Target Name="RejectRuntimeDeploymentFiles" AfterTargets="Publish">
    <ItemGroup>
      <ForbiddenAppJson Include="$(PublishDir)**\*.json" />
      <ForbiddenRuntime Include="$(PublishDir)**\coreclr.dll;$(PublishDir)**\hostfxr.dll;$(PublishDir)**\hostpolicy.dll;$(PublishDir)**\createdump.exe;$(PublishDir)**\crashdump.exe" />
    </ItemGroup>
    <Error Condition="'@(ForbiddenAppJson)' != ''"
           Text="Application JSON files are prohibited: @(ForbiddenAppJson)" />
    <Error Condition="'@(ForbiddenRuntime)' != ''"
           Text="Bundled .NET runtime files are prohibited: @(ForbiddenRuntime)" />
  </Target>

  <Target Name="RemoveUnusedWebViewRuntime" AfterTargets="Publish">
    <ItemGroup>
      <UnusedWebViewRuntime Include="$(PublishDir)Microsoft.Web.WebView2.Core.dll" />
      <UnusedWebViewRuntime Include="$(PublishDir)Microsoft.Web.WebView2.Core.Projection.dll" />
      <UnusedWebViewRuntime Include="$(PublishDir)WebView2Loader.dll" />
    </ItemGroup>
    <Delete Files="@(UnusedWebViewRuntime)" />
  </Target>
</Project>
