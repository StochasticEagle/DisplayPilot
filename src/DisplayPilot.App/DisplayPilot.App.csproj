<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DisplayPilot.App</RootNamespace>
    <AssemblyName>DisplayPilot</AssemblyName>
    <Description>WinUI 3 desktop application for DisplayPilot.</Description>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(BuildMsix)' != 'true'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(BuildMsix)' != 'true'">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(BuildMsix)' != 'true'">true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\displaypilot-primary.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildMsix)' == 'true'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\..\artifacts\msix\</AppxPackageDir>
  </PropertyGroup>

  <ItemGroup>
    <None
      Update="Assets\displaypilot-compact.ico"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <None
      Update="Assets\displaypilot-primary.ico"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <None
      Update="Assets\displaypilot-primary-256.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\StoreLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\DisplayPilot.Core\DisplayPilot.Core.csproj" />
    <ProjectReference Include="..\DisplayPilot.Display\DisplayPilot.Display.csproj" />
    <ProjectReference Include="..\DisplayPilot.Windows\DisplayPilot.Windows.csproj" />
  </ItemGroup>
</Project>
