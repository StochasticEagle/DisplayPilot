<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DisplayPilot.App</RootNamespace>
    <AssemblyName>DisplayPilot</AssemblyName>
    <Description>WinUI 3 desktop application for DisplayPilot.</Description>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <OptimizationPreference>Size</OptimizationPreference>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <DisableEmbeddedXbf>false</DisableEmbeddedXbf>
    <_SupportEmbedFileResources>true</_SupportEmbedFileResources>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\displaypilot-primary.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\displaypilot-compact.ico" />
    <EmbeddedResource Include="Assets\displaypilot-primary-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <ProjectReference Include="..\DisplayPilot.Core\DisplayPilot.Core.csproj" />
    <ProjectReference Include="..\DisplayPilot.Display\DisplayPilot.Display.csproj" />
    <ProjectReference Include="..\DisplayPilot.Windows\DisplayPilot.Windows.csproj" />
  </ItemGroup>

  <!-- XAML is compiled into the WinUI resource index; remove only loose
       copies after packaging. These tasks use MSBuild, not a shell. -->
  <Target Name="RemoveLooseCompiledXamlFromBuild" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <LooseCompiledXaml Include="$(TargetDir)**\App.xbf;$(TargetDir)**\MainWindow.xbf" />
    </ItemGroup>
    <Delete Files="@(LooseCompiledXaml)" />
  </Target>
  <Target Name="RemoveLooseCompiledXamlFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedCompiledXaml Include="$(PublishDir)**\App.xbf;$(PublishDir)**\MainWindow.xbf" />
    </ItemGroup>
    <Delete Files="@(PublishedCompiledXaml)" />
  </Target>

  <Target Name="RemoveUnusedWebViewRuntime" AfterTargets="Publish">
    <ItemGroup>
      <UnusedWebViewRuntime Include="$(PublishDir)Microsoft.Web.WebView2.Core.dll" />
      <UnusedWebViewRuntime Include="$(PublishDir)Microsoft.Web.WebView2.Core.Projection.dll" />
      <UnusedWebViewRuntime Include="$(PublishDir)WebView2Loader.dll" />
    </ItemGroup>
    <Delete Files="@(UnusedWebViewRuntime)" />
  </Target>
</Project>
