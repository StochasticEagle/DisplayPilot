<Window
    x:Class="DisplayPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DisplayPilot.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DisplayPilot"
    mc:Ignorable="d">

    <Grid
        x:Name="WindowRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="RootGrid_Loaded">
        <!-- Compact notification-area flyout -->
        <Grid
            x:Name="CompactView"
            Padding="20,16,20,16"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="DisplayPilot" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Brightness &amp; theme" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="HideCompactButton_Click"
                        ToolTipService.ToolTip="Hide DisplayPilot">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                    <Button
                        Click="ShowAdvancedButton_Click"
                        Content="Advanced" />
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border
                        Padding="14,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Displays" />
                                <Button
                                    x:Name="CompactReadBrightnessButton"
                                    Grid.Column="1"
                                    Click="CompactReadBrightnessButton_Click"
                                    Content="Refresh controls" />
                            </Grid>

                            <ListView
                                x:Name="CompactMonitorList"
                                HorizontalContentAlignment="Stretch"
                                MaxHeight="360"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:CompactMonitorViewModel">
                                        <Grid
                                            Margin="0,2"
                                            ColumnSpacing="10"
                                            RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind FriendlyName, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind BrightnessText, Mode=OneWay}" />
                                            <Slider
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Minimum="0"
                                                Maximum="100"
                                                IsEnabled="{x:Bind IsBrightnessAvailable, Mode=OneTime}"
                                                StepFrequency="1"
                                                Tag="{x:Bind}"
                                                ValueChanged="CompactBrightnessSlider_ValueChanged"
                                                Value="{x:Bind BrightnessPercent, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Row="2"
                                                FontWeight="SemiBold"
                                                Text="Contrast"
                                                Visibility="{x:Bind ContrastVisibility, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind ContrastText, Mode=OneWay}"
                                                Visibility="{x:Bind ContrastVisibility, Mode=OneTime}" />
                                            <Slider
                                                Grid.Row="3"
                                                Grid.ColumnSpan="2"
                                                Minimum="0"
                                                Maximum="100"
                                                IsEnabled="{x:Bind IsContrastAvailable, Mode=OneTime}"
                                                StepFrequency="1"
                                                Tag="{x:Bind}"
                                                ValueChanged="CompactContrastSlider_ValueChanged"
                                                Value="{x:Bind ContrastPercent, Mode=TwoWay}"
                                                Visibility="{x:Bind ContrastVisibility, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Row="4"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="Color temperature"
                                                Visibility="{x:Bind ColorTemperatureVisibility, Mode=OneTime}" />
                                            <ComboBox
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                MinWidth="150"
                                                DisplayMemberPath="DisplayName"
                                                IsEnabled="{x:Bind IsColorTemperatureAvailable, Mode=OneTime}"
                                                ItemsSource="{x:Bind ColorTemperaturePresets, Mode=OneTime}"
                                                SelectionChanged="CompactColorTemperature_SelectionChanged"
                                                SelectedItem="{x:Bind SelectedColorTemperaturePreset, Mode=TwoWay}"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind ColorTemperatureVisibility, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Row="5"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="Rotation"
                                                Visibility="{x:Bind RotationVisibility, Mode=OneTime}" />
                                            <StackPanel
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind RotationVisibility, Mode=OneTime}">
                                                <ComboBox
                                                    MinWidth="170"
                                                    DisplayMemberPath="DisplayName"
                                                    IsEnabled="{x:Bind IsRotationAvailable, Mode=OneTime}"
                                                    ItemsSource="{x:Bind RotationOptions, Mode=OneTime}"
                                                    SelectedItem="{x:Bind SelectedRotation, Mode=TwoWay}" />
                                                <Button
                                                    Click="CompactApplyRotationButton_Click"
                                                    Content="Apply"
                                                    IsEnabled="{x:Bind IsRotationAvailable, Mode=OneTime}"
                                                    Tag="{x:Bind}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Row="6"
                                                Grid.ColumnSpan="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Status, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="14,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Theme" />
                                <TextBlock
                                    x:Name="CompactThemeStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Reading Windows theme..." />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="CompactDarkModeToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                OffContent="Light"
                                OnContent="Dark"
                                Toggled="CompactDarkModeToggle_Toggled" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="14,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="Theme schedule" />
                                    <TextBlock
                                        x:Name="CompactScheduleStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Loading saved schedule..."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="CompactScheduleAutomationToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="CompactScheduleAutomationToggle_Toggled" />
                            </Grid>

                            <StackPanel x:Name="CompactScheduleOptions" Spacing="10">
                                <ComboBox
                                    x:Name="CompactScheduleModeComboBox"
                                    Header="Schedule type"
                                    SelectionChanged="CompactScheduleModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Fixed times" />
                                    <ComboBoxItem Content="Sunrise and sunset" />
                                </ComboBox>

                                <Grid x:Name="CompactFixedScheduleOptions" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TimePicker
                                        x:Name="CompactLightScheduleTimePicker"
                                        ClockIdentifier="24HourClock"
                                        Header="Light starts"
                                        MinuteIncrement="1" />
                                    <TimePicker
                                        x:Name="CompactDarkScheduleTimePicker"
                                        Grid.Column="1"
                                        ClockIdentifier="24HourClock"
                                        Header="Dark starts"
                                        MinuteIncrement="1" />
                                </Grid>

                                <StackPanel x:Name="CompactSolarScheduleOptions" Spacing="8" Visibility="Collapsed">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Enter decimal coordinates (north/east positive, south/west negative), or request them from Windows."
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="CompactSolarLocationLabelTextBox"
                                        Header="Location label (optional)"
                                        PlaceholderText="Home" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Name="CompactSolarLatitudeNumberBox"
                                            Header="Latitude"
                                            Maximum="90"
                                            Minimum="-90"
                                            SmallChange="0.1" />
                                        <NumberBox
                                            x:Name="CompactSolarLongitudeNumberBox"
                                            Grid.Column="1"
                                            Header="Longitude"
                                            Maximum="180"
                                            Minimum="-180"
                                            SmallChange="0.1" />
                                    </Grid>
                                    <Button
                                        x:Name="CompactUseWindowsLocationButton"
                                        HorizontalAlignment="Left"
                                        Click="UseWindowsLocationButton_Click"
                                        Content="Use Windows location" />
                                    <TextBlock
                                        x:Name="CompactSolarLocationStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Coordinates are calculated in the current Windows time zone."
                                        TextWrapping="Wrap" />
                                    <Grid x:Name="CompactSolarCalculatedTimes" ColumnSpacing="12" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TimePicker
                                            x:Name="CompactSolarLightTimePicker"
                                            ClockIdentifier="24HourClock"
                                            Header="Light starts"
                                            IsHitTestVisible="False"
                                            IsTabStop="False" />
                                        <TimePicker
                                            x:Name="CompactSolarDarkTimePicker"
                                            Grid.Column="1"
                                            ClockIdentifier="24HourClock"
                                            Header="Dark starts"
                                            IsHitTestVisible="False"
                                            IsTabStop="False" />
                                    </Grid>
                                </StackPanel>

                                <CheckBox
                                    x:Name="CompactReduceBrightnessCheckBox"
                                    Content="Reduce screen brightness during dark hours" />

                                <Button
                                    HorizontalAlignment="Left"
                                    Click="SaveCompactScheduleButton_Click"
                                    Content="Save schedule" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TextBlock
                x:Name="CompactStatusText"
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="DisplayPilot is running in the notification area."
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Existing full interface, retained as Advanced -->
        <Grid
            x:Name="AdvancedView"
            VerticalAlignment="Stretch"
            Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Padding="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <Image
                    x:Name="AdvancedIcon"
                    Width="72"
                    Height="72"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    Stretch="Uniform" />
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="DisplayPilot" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Windows theme and display verification" />
                <TextBlock
                    x:Name="AdvancedVersionText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Version 0.5.0" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="ShowCompactButton_Click"
                    Content="Controls" />
                <Button
                    x:Name="RescanButton"
                    Click="RescanButton_Click"
                    Content="Rescan displays" />
                <Button
                    x:Name="ProbeDdcButton"
                    Click="ProbeDdcButton_Click"
                    Content="Refresh display controls"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- Main Workspace (Two-Column Layout) -->
        <Grid
            Grid.Row="1"
            Padding="24,0,24,12"
            ColumnSpacing="24"
            VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <!-- Left Column: Main Display List Content -->
                <ColumnDefinition Width="*" />
                <!-- Right Column: Settings, Schedules & Actions -->
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- Main Display List Content (Left Column) -->
            <Grid
                Grid.Column="0"
                VerticalAlignment="Stretch">
                <ListView
                    x:Name="MonitorList"
                    HorizontalContentAlignment="Stretch"
                    SelectionMode="None"
                    VerticalAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CompactMonitorViewModel">
                            <Border
                                Margin="0,0,0,10"
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind FriendlyName, Mode=OneTime}" />

                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Status, Mode=OneTime}" />

                                    <Expander Header="Display details">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontWeight="SemiBold" Text="Windows name" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                Text="{x:Bind GdiDeviceName, Mode=OneTime}" />
                                            <TextBlock FontWeight="SemiBold" Text="Stable device path" />
                                            <TextBox
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontFamily="Consolas"
                                                IsHitTestVisible="False"
                                                IsReadOnly="True"
                                                IsTabStop="False"
                                                Text="{x:Bind DevicePath, Mode=OneTime}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>

                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock FontWeight="SemiBold" Text="Brightness" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind BrightnessText, Mode=OneWay}" />
                                        <Slider
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Minimum="0"
                                            Maximum="100"
                                            IsEnabled="{x:Bind IsBrightnessAvailable, Mode=OneTime}"
                                            StepFrequency="1"
                                            Tag="{x:Bind}"
                                            ValueChanged="CompactBrightnessSlider_ValueChanged"
                                            Value="{x:Bind BrightnessPercent, Mode=TwoWay}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            FontWeight="SemiBold"
                                            Text="Contrast"
                                            Visibility="{x:Bind ContrastVisibility, Mode=OneTime}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ContrastText, Mode=OneWay}"
                                            Visibility="{x:Bind ContrastVisibility, Mode=OneTime}" />
                                        <Slider
                                            Grid.Row="3"
                                            Grid.ColumnSpan="2"
                                            Minimum="0"
                                            Maximum="100"
                                            StepFrequency="1"
                                            Tag="{x:Bind}"
                                            ValueChanged="CompactContrastSlider_ValueChanged"
                                            Value="{x:Bind ContrastPercent, Mode=TwoWay}"
                                            Visibility="{x:Bind ContrastVisibility, Mode=OneTime}" />

                                        <TextBlock
                                            Grid.Row="4"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Color temperature"
                                            Visibility="{x:Bind ColorTemperatureVisibility, Mode=OneTime}" />
                                        <ComboBox
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            MinWidth="170"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{x:Bind ColorTemperaturePresets, Mode=OneTime}"
                                            SelectionChanged="CompactColorTemperature_SelectionChanged"
                                            SelectedItem="{x:Bind SelectedColorTemperaturePreset, Mode=TwoWay}"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind ColorTemperatureVisibility, Mode=OneTime}" />

                                        <TextBlock
                                            Grid.Row="5"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Rotation"
                                            Visibility="{x:Bind RotationVisibility, Mode=OneTime}" />
                                        <StackPanel
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="{x:Bind RotationVisibility, Mode=OneTime}">
                                            <ComboBox
                                                MinWidth="190"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{x:Bind RotationOptions, Mode=OneTime}"
                                                SelectedItem="{x:Bind SelectedRotation, Mode=TwoWay}" />
                                            <Button
                                                Click="CompactApplyRotationButton_Click"
                                                Content="Apply"
                                                Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="36"
                        Glyph="&#xE7F4;" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="No active display paths were returned." />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Try rescanning after the Windows desktop has finished loading." />
                </StackPanel>
            </Grid>

            <!-- Configuration & Control Side Panel (Right Column) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <!-- Theme Card -->
                    <Border
                        Padding="16,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Windows theme" />
                                <TextBlock
                                    x:Name="ThemeStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Reading current app and system theme..." />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="RefreshThemeButton"
                                    Click="RefreshThemeButton_Click"
                                    Content="Refresh" />
                                <Button
                                    x:Name="ApplyLightThemeButton"
                                    Click="ApplyLightThemeButton_Click"
                                    Content="Light" />
                                <Button
                                    x:Name="ApplyDarkThemeButton"
                                    Click="ApplyDarkThemeButton_Click"
                                    Content="Dark" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Theme Schedule Card -->
                    <Border
                        Padding="16,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Theme schedule" />
                                <TextBlock
                                    x:Name="ScheduleStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Choose different light and dark transition times."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="ScheduleAutomationToggle"
                                Header="Automatic switching"
                                OffContent="Off"
                                OnContent="On while DisplayPilot is running"
                                Toggled="ScheduleAutomationToggle_Toggled" />

                            <StackPanel x:Name="ScheduleOptions" Spacing="10">
                                <ComboBox
                                    x:Name="ScheduleModeComboBox"
                                    Header="Schedule type"
                                    SelectionChanged="ScheduleModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Fixed times" />
                                    <ComboBoxItem Content="Sunrise and sunset" />
                                </ComboBox>

                                <StackPanel x:Name="FixedScheduleOptions" Orientation="Horizontal" Spacing="12">
                                    <Viewbox Width="220" Stretch="Uniform">
                                        <TimePicker
                                            x:Name="LightScheduleTimePicker"
                                            ClockIdentifier="24HourClock"
                                            Header="Light starts" />
                                    </Viewbox>

                                    <Viewbox Width="220" Height="80" Stretch="Uniform">
                                        <TimePicker
                                            x:Name="DarkScheduleTimePicker"
                                            ClockIdentifier="24HourClock"
                                            Header="Dark starts" />
                                    </Viewbox>
                                </StackPanel>

                                <StackPanel x:Name="SolarScheduleOptions" Spacing="8" Visibility="Collapsed">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Enter decimal coordinates (north/east positive, south/west negative), or request them from Windows. No online service is used."
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        x:Name="SolarLocationLabelTextBox"
                                        Header="Location label (optional)"
                                        PlaceholderText="Home" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <NumberBox
                                            x:Name="SolarLatitudeNumberBox"
                                            Width="180"
                                            Header="Latitude"
                                            Maximum="90"
                                            Minimum="-90"
                                            SmallChange="0.1" />
                                        <NumberBox
                                            x:Name="SolarLongitudeNumberBox"
                                            Width="180"
                                            Header="Longitude"
                                            Maximum="180"
                                            Minimum="-180"
                                            SmallChange="0.1" />
                                    </StackPanel>
                                    <Button
                                        x:Name="UseWindowsLocationButton"
                                        HorizontalAlignment="Left"
                                        Click="UseWindowsLocationButton_Click"
                                        Content="Use Windows location" />
                                    <TextBlock
                                        x:Name="SolarLocationStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Coordinates are calculated in the current Windows time zone."
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        x:Name="SolarCalculatedTimes"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        Visibility="Collapsed">
                                        <Viewbox Width="220" Height="80" Stretch="Uniform">
                                            <TimePicker
                                                x:Name="SolarLightTimePicker"
                                                ClockIdentifier="24HourClock"
                                                Header="Light starts"
                                                IsHitTestVisible="False"
                                                IsTabStop="False" />
                                        </Viewbox>
                                        <Viewbox Width="220" Height="80" Stretch="Uniform">
                                            <TimePicker
                                                x:Name="SolarDarkTimePicker"
                                                ClockIdentifier="24HourClock"
                                                Header="Dark starts"
                                                IsHitTestVisible="False"
                                                IsTabStop="False" />
                                        </Viewbox>
                                    </StackPanel>
                                </StackPanel>

                                <CheckBox
                                    x:Name="ReduceBrightnessCheckBox"
                                    Content="Reduce screen brightness during dark hours" />

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Click="PreviewScheduleButton_Click" Content="Preview schedule" />
                                    <Button Click="SaveScheduleButton_Click" Content="Save schedule" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="SchedulePersistenceStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Schedule settings have not been loaded."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Startup Card -->
                    <Border
                        Padding="16,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Start DisplayPilot at sign-in" />
                            <TextBlock
                                x:Name="StartupStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Reading startup registration..."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="OpenStartupSettingsButton"
                                Click="OpenStartupSettingsButton_Click"
                                Content="Open Windows Startup settings"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Verification InfoBar -->
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="DisplayPilot verifies brightness, contrast, and advertised color-temperature changes with an immediate read-back. Unsupported optional controls are hidden."
                        Severity="Warning"
                        Title="Display-control verification" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer Bar -->
        <Border
            Grid.Row="2"
            Padding="24,12,24,20"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock
                        x:Name="StatusText"
                        FontWeight="SemiBold"
                        Text="Waiting to scan..." />
                    <TextBlock x:Name="SystemText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="CopyReportButton"
                        VerticalAlignment="Bottom"
                        Click="CopyReportButton_Click"
                        Content="Copy diagnostic report"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
